<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 焦点态：亮蓝边 + 深蓝底，3 米外也能一眼看到 -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/focus_bg" />
            <stroke
                android:width="3dp"
                android:color="@color/focus_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/focus_bg" />
            <stroke
                android:width="3dp"
                android:color="@color/focus_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/panel_alt" />
            <stroke
                android:width="1dp"
                android:color="@color/panel_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
