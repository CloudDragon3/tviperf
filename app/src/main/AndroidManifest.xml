<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 权限最小化：只申请这两项，不需要任何存储 / 定位 / USB 授权 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- required=false 是为了让同一个 APK 也能侧载到手机 / 模拟器上做冒烟测试；
         电视主屏仍靠下面的 LEANBACK_LAUNCHER 生效 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- 同时声明两个 category：
                 LEANBACK_LAUNCHER -> 标准 Android TV 主屏（Google 认证机型，如 TCL）
                 LAUNCHER          -> 手机桌面 / 品牌自研 launcher（部分海信、创维等非标准 TV 系统只认这个）
                 只写 LEANBACK 会导致在自研 launcher 的电视上"装上了但找不到图标" -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.DiagPanelActivity"
            android:exported="false" />
    </application>

</manifest>
